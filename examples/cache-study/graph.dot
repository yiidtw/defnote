digraph adef {
  rankdir=BT;
  node [style="filled,rounded", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8];
  "e-bench1" [label="e-bench1\ncache cuts p99 latency 800ms -> 120ms ", shape=box, color="#1a7f37", fillcolor="#dafbe1"];
  "c-win" [label="c-win\nthe cache is always a net win", shape=ellipse, color="#cf222e", fillcolor="#ffebe9" fontcolor="#8b949e"];
  "c-default" [label="c-default\nenable the cache by default everywhere", shape=ellipse, color="#cf222e", fillcolor="#ffebe9" fontcolor="#8b949e"];
  "e-bench2" [label="e-bench2\nunder memory pressure the cache thrash", shape=box, color="#1a7f37", fillcolor="#dafbe1"];
  "c-eviction" [label="c-eviction\nadd an eviction policy so the cache su", shape=ellipse, color="#1a7f37", fillcolor="#dafbe1"];
  "c-refined" [label="c-refined\nthe cache is a net win only when memor", shape=ellipse, color="#1a7f37", fillcolor="#dafbe1"];
  "c-warmup" [label="c-warmup\nthe cache warms in under 1 second", shape=ellipse, color="#57606a", fillcolor="#eaeef2"];
  "e-bench1" -> "c-win" [color="#1a7f37"];
  "e-bench2" -> "c-win" [color="#cf222e", style=dashed, label="refutes"];
  "c-win" -> "c-default" [color="#1a7f37"];
  "e-bench1" -> "c-eviction" [color="#1a7f37"];
  "e-bench2" -> "c-eviction" [color="#1a7f37"];
  "e-bench1" -> "c-refined" [color="#1a7f37"];
  "e-bench2" -> "c-refined" [color="#1a7f37"];
  "c-refined" -> "c-win" [color="#8b949e", style=dotted, label="supersedes"];
}
